# career-ops OpenRouter configuration
# Copy this file to .env and fill in your key:
#   copy .env.example .env
#
# Free API key: https://openrouter.ai → Sign Up → Keys

OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# Optional: pin a specific model instead of using auto-rotation
# Free model options (fetched live from the OpenRouter API at runtime):
#   google/gemini-2.0-flash-exp:free   (1M context, fast)
#   deepseek/deepseek-r1:free          (strong reasoning)
#   meta-llama/llama-4-maverick:free   (fast, good instruction-following)
#   mistralai/mistral-7b-instruct:free (lightweight)
#
# CAREER_OPS_MODEL=google/gemini-2.0-flash-exp:free
