# Groq API — free tier at https://console.groq.com
GROQ_API_KEY=gsk_...

# Brave Search API — free tier at https://api.search.brave.com
# Leave blank to use stub responses (no real web search)
BRAVE_API_KEY=

# Server
PORT=3000
HOST=localhost

# Supabase — optional, leave blank to use in-memory store
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Edge TTS voice (see https://speech.microsoft.com/portal for voice names)
TTS_VOICE=en-US-AriaNeural
