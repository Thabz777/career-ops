# All services used by Trillion are free-tier — no paid subscriptions required.

# ── Required ───────────────────────────────────────────────────────────────
# Groq API (free tier — sign up at https://console.groq.com)
# Provides: LLM (llama-3.3-70b-versatile) + STT (whisper-large-v3)
# Free limits: generous daily token quota, no credit card needed
GROQ_API_KEY=gsk_...

# ── Optional ───────────────────────────────────────────────────────────────
# Brave Search API (free tier — https://api.search.brave.com)
# Free limits: 2,000 queries/month, no credit card needed
# Leave blank to use stub responses (still works, just returns placeholder)
BRAVE_API_KEY=

# TTS: handled client-side via the browser's built-in Web Speech API
# (window.speechSynthesis) — 100% free, no API key, no external calls.

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3000
HOST=localhost
